<Application
    x:Class="Pulsar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Pulsar brand: the logo's green replaces Windows' accent color everywhere
                (buttons, progress bars, toggles, selection). Light theme uses the darker
                shades so white text on accent buttons stays above 4.5:1 contrast;
                dark theme uses the lighter shades with dark text.
            -->
            <Color x:Key="SystemAccentColor">#2BD47D</Color>
            <Color x:Key="SystemAccentColorLight1">#4FE596</Color>
            <Color x:Key="SystemAccentColorLight2">#78F2B0</Color>
            <Color x:Key="SystemAccentColorLight3">#A8F8CC</Color>
            <Color x:Key="SystemAccentColorDark1">#0E7F45</Color>
            <Color x:Key="SystemAccentColorDark2">#006840</Color>
            <Color x:Key="SystemAccentColorDark3">#004D30</Color>

            <Color x:Key="PulsarInkColor">#121521</Color>
            <Color x:Key="PulsarGlowColor">#60F898</Color>
            <SolidColorBrush x:Key="PulsarInkBrush" Color="{StaticResource PulsarInkColor}" />
            <SolidColorBrush x:Key="PulsarGlowBrush" Color="{StaticResource PulsarGlowColor}" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>

            <Style x:Key="DividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
