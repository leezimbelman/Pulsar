<Page
    x:Class="Pulsar.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Pulsar.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="28,8,28,24" Spacing="12" MaxWidth="980" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <RadioButtons Header="Theme" SelectedIndex="{x:Bind VM.ThemeIndex, Mode=TwoWay}" MaxColumns="3">
                    <x:String>Use Windows setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </RadioButtons>
            </Border>

            <!-- Downloads -->
            <TextBlock Text="Downloads" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="Default download folder" Text="{x:Bind VM.DownloadFolder, Mode=TwoWay}" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse…" Command="{x:Bind VM.BrowseDownloadFolderCommand}" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBox Header="File name template" Text="{x:Bind VM.FileTemplate, Mode=TwoWay}" FontFamily="Cascadia Mono, Consolas" />
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="yt-dlp output template. Examples: %(title)s.%(ext)s   •   %(uploader)s/%(title)s.%(ext)s   •   %(playlist_index)03d - %(title)s.%(ext)s" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Header="Default format preset" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind VM.Presets}" SelectedIndex="{x:Bind VM.DefaultPresetIndex, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1" Header="Simultaneous downloads" Minimum="1" Maximum="8"
                                   SpinButtonPlacementMode="Compact" Value="{x:Bind VM.MaxConcurrent, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <ComboBox Header="Use cookies from browser" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind VM.BrowserNames}" SelectedIndex="{x:Bind VM.CookiesIndex, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="Lets yt-dlp use your signed-in session for members-only or age-restricted videos. Chrome and Edge may need to be closed while downloading." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBox Header="Speed limit per download" PlaceholderText="Unlimited (e.g. 500K or 5M)"
                                     Text="{x:Bind VM.RateLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Text="{x:Bind VM.RateLimitError, Mode=OneWay}" Visibility="{x:Bind VM.HasRateLimitError, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <ToggleSwitch Header="Embed thumbnail as cover art by default" IsOn="{x:Bind VM.EmbedThumbnail, Mode=TwoWay}" />
                    <ToggleSwitch Header="Embed metadata by default" IsOn="{x:Bind VM.EmbedMetadata, Mode=TwoWay}" />
                    <ToggleSwitch Header="Embed chapters by default" IsOn="{x:Bind VM.EmbedChapters, Mode=TwoWay}" />
                    <ToggleSwitch Header="Offer to download links I copy" IsOn="{x:Bind VM.WatchClipboard, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource HintTextStyle}" Text="The default preset and simultaneous downloads take effect the next time you open Pulsar." />
                </StackPanel>
            </Border>

            <!-- SponsorBlock -->
            <TextBlock Text="SponsorBlock" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="Uses community-submitted segments from sponsor.ajay.app for YouTube videos." />
                    <ComboBox Header="Default for new downloads" MinWidth="320" SelectedIndex="{x:Bind VM.SponsorBlockMode, Mode=TwoWay}">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="Mark segments as chapters" />
                        <ComboBoxItem Content="Cut segments out of the file" />
                    </ComboBox>
                    <TextBlock Text="Segment types" Style="{StaticResource BodyTextBlockStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind VM.SponsorCategories}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="260" MinRowSpacing="2" MinColumnSpacing="12" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ToggleItem">
                                <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Background -->
            <TextBlock Text="Background and notifications" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <ToggleSwitch Header="Minimize to the system tray" IsOn="{x:Bind VM.MinimizeToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="Keep running in the tray when I close the window" IsOn="{x:Bind VM.CloseToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start Pulsar in the tray when I sign in to Windows" IsOn="{x:Bind VM.StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch Header="Notify me when downloads and tools finish in the background" IsOn="{x:Bind VM.NotifyOnComplete, Mode=TwoWay}" />
                    <ToggleSwitch Header="Add Pulsar to Explorer's &quot;Send to&quot; menu" IsOn="{x:Bind VM.SendToEnabled, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="Send to adds &quot;Pulsar Player&quot; and &quot;Pulsar Tools&quot;. Right-click a file, then Send to (on Windows 11, Show more options first)." />
                    <InfoBar Severity="Error" IsClosable="False" Message="{x:Bind VM.ShellError, Mode=OneWay}" IsOpen="{x:Bind VM.HasShellError, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Transcription -->
            <TextBlock Text="Transcription (Whisper)" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <RadioButtons Header="Engine" SelectedIndex="{x:Bind VM.WhisperEngineIndex, Mode=TwoWay}">
                        <x:String>On this PC (whisper.cpp, private and free, runs on your CPU)</x:String>
                        <x:String>Server (OpenAI or any OpenAI-compatible speech-to-text server)</x:String>
                    </RadioButtons>

                    <StackPanel Spacing="12" Visibility="{x:Bind VM.IsLocalWhisper, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Model" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.WhisperModelNames}"
                                      SelectedIndex="{x:Bind VM.WhisperModelIndex, Mode=TwoWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Download now" Command="{x:Bind VM.DownloadWhisperCommand}" />
                        </Grid>
                        <TextBlock Text="{x:Bind VM.WhisperStatus, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Use my own whisper-cli.exe (optional, e.g. a CUDA or Vulkan build)"
                                     PlaceholderText="Leave blank to use the copy Pulsar downloads"
                                     Text="{x:Bind VM.WhisperCustomExe, Mode=TwoWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse…" Command="{x:Bind VM.BrowseWhisperExeCommand}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind VM.IsServerWhisper, Mode=OneWay}">
                        <TextBox Header="Server address" PlaceholderText="https://api.openai.com  or  http://my-server:8000"
                                 Text="{x:Bind VM.WhisperServerUrl, Mode=TwoWay}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Model name" PlaceholderText="whisper-1" Text="{x:Bind VM.WhisperServerModel, Mode=TwoWay}" />
                            <PasswordBox Grid.Column="1" Header="API key (if the server needs one)" Password="{x:Bind VM.WhisperApiKey, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="Audio is uploaded to this server. Pulsar calls /v1/audio/transcriptions. The key is encrypted for your Windows account." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Components -->
            <TextBlock Text="Components" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="yt-dlp" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource HintTextStyle}">
                                <Run Text="Installed: " /><Run Text="{x:Bind VM.YtDlpVersion, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource HintTextStyle}">
                                <Run Text="Latest: " /><Run Text="{x:Bind VM.LatestVersion, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Check for updates" Command="{x:Bind VM.CheckForUpdatesCommand}" />
                            <Button Style="{StaticResource AccentButtonStyle}" Content="Update" Command="{x:Bind VM.UpdateYtDlpCommand}" />
                            <Button Content="{x:Bind VM.YtDlpInstallLabel, Mode=OneWay}" Command="{x:Bind VM.InstallYtDlpCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Header="Update channel" MinWidth="180" SelectedIndex="{x:Bind VM.UpdateChannelIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Stable" />
                            <ComboBoxItem Content="Nightly" />
                        </ComboBox>
                        <ToggleSwitch Grid.Column="1" Header="Check for yt-dlp updates on startup" IsOn="{x:Bind VM.CheckForUpdatesOnStartup, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="Sites change often, and an outdated yt-dlp is the usual reason downloads start failing. Nightly gets fixes first." />

                    <Border Style="{StaticResource DividerStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="ffmpeg + ffprobe" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource HintTextStyle}">
                                <Run Text="Installed: " /><Run Text="{x:Bind VM.FfmpegVersion, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Bind VM.FfmpegInstallLabel, Mode=OneWay}" Command="{x:Bind VM.InstallFfmpegCommand}" />
                    </Grid>

                    <Border Style="{StaticResource DividerStyle}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind VM.ToolStatus, Mode=OneWay}" TextWrapping="Wrap" />
                        <ProgressBar Value="{x:Bind VM.ToolProgress, Mode=OneWay}"
                                     IsIndeterminate="{x:Bind VM.ToolProgressIndeterminate, Mode=OneWay}"
                                     Visibility="{x:Bind VM.IsBusy, Mode=OneWay}" />
                        <Expander Header="Log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBox Text="{x:Bind VM.ToolLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="120" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Expander>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Open tools folder" Command="{x:Bind VM.OpenBinFolderCommand}" />
                            <Button Content="Open data folder" Command="{x:Bind VM.OpenDataFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/Pulsar-256.png" Width="56" Height="56" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind VM.VersionText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="Open source under the MIT license. Built on yt-dlp, FFmpeg, LibVLC and whisper.cpp, each under its own license. Only download content you have the right to." />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
