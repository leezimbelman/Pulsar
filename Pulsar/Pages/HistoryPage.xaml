<Page
    x:Class="Pulsar.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pulsar.Models"
    NavigationCacheMode="Required">

    <Grid Padding="28,8,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind VM.CountText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Clear history">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="10" MaxWidth="260">
                            <TextBlock Text="Remove every entry from the history? Your downloaded files stay where they are." TextWrapping="Wrap" />
                            <Button Content="Clear history" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind VM.ClearAllCommand}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <AutoSuggestBox Grid.Row="1" PlaceholderText="Search titles, file names and links" QueryIcon="Find"
                        Text="{x:Bind VM.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Text="{x:Bind VM.EmptyText, Mode=OneWay}" Style="{StaticResource HintTextStyle}"
                   HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="{x:Bind VM.IsEmpty, Mode=OneWay}" />

        <ListView Grid.Row="2" ItemsSource="{x:Bind VM.Items}" SelectionMode="None" Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:HistoryEntry">
                    <Border Style="{StaticResource CardStyle}" Padding="14,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FileName}" Style="{StaticResource HintTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Details}" Style="{StaticResource HintTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Click="Play_Click" ToolTipService.ToolTip="Play" IsEnabled="{x:Bind FileExists}">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                </Button>
                                <Button Click="Folder_Click" ToolTipService.ToolTip="Show in folder">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                                <Button ToolTipService.ToolTip="More">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="Download again" Click="Again_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy link" Click="Copy_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Open in tools" Click="Tools_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE90F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Remove from history" Click="Remove_Click" Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
