<Page
    x:Class="Pulsar.Pages.SubscriptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pulsar.Models"
    NavigationCacheMode="Required">

    <Grid Padding="28,8,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Subscriptions" Style="{StaticResource TitleTextBlockStyle}" />

        <!-- Add -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource HintTextStyle}"
                           Text="Follow a channel or playlist and Pulsar downloads new uploads automatically while it's running. To keep it running in the background, turn on the tray options and Start with Windows in Settings." />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Channel or playlist URL" PlaceholderText="https://www.youtube.com/@channel/videos"
                             Text="{x:Bind VM.NewUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Header="Name (optional)" PlaceholderText="Uses the channel name"
                             Text="{x:Bind VM.NewName, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Header="Format" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.Presets}"
                              SelectedIndex="{x:Bind VM.NewPresetIndex, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Check" MinWidth="150" SelectedIndex="{x:Bind VM.NewIntervalIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Every hour" />
                        <ComboBoxItem Content="Every 3 hours" />
                        <ComboBoxItem Content="Every 6 hours" />
                        <ComboBoxItem Content="Every 12 hours" />
                        <ComboBoxItem Content="Daily" />
                        <ComboBoxItem Content="Weekly" />
                    </ComboBox>
                    <ComboBox Grid.Column="2" Header="Look at the newest" MinWidth="150" SelectedIndex="{x:Bind VM.NewItemsIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="5 videos" />
                        <ComboBoxItem Content="10 videos" />
                        <ComboBoxItem Content="25 videos" />
                        <ComboBoxItem Content="50 videos" />
                    </ComboBox>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Save to" Text="{x:Bind VM.NewFolder, Mode=TwoWay}" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse…" Command="{x:Bind VM.BrowseFolderCommand}" />
                </Grid>
                <Grid>
                    <CheckBox Content="Only new uploads (skip what's already on the channel)" IsChecked="{x:Bind VM.OnlyNew, Mode=TwoWay}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <ProgressRing IsActive="{x:Bind VM.IsAdding, Mode=OneWay}" Width="18" Height="18" />
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind VM.AddCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Subscribe" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <InfoBar Severity="Informational" IsClosable="True" Message="{x:Bind VM.Message, Mode=OneWay}" IsOpen="{x:Bind VM.HasMessage, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock Text="Following" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Content="Check all now" Command="{x:Bind VM.CheckAllCommand}" />
        </Grid>

        <TextBlock Grid.Row="3" Text="You're not following anything yet." Style="{StaticResource HintTextStyle}"
                   HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="{x:Bind VM.IsEmpty, Mode=OneWay}" />

        <ListView Grid.Row="3" ItemsSource="{x:Bind VM.Items}" SelectionMode="None" Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:Subscription">
                    <Border Style="{StaticResource CardStyle}" Padding="14,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource HintTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <ToggleSwitch IsOn="{x:Bind Enabled, Mode=OneWay}" Toggled="Enabled_Toggled" OnContent="On" OffContent="Paused" MinWidth="0" />
                                <Button Click="Check_Click" ToolTipService.ToolTip="Check now">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                                <Button Click="Folder_Click" ToolTipService.ToolTip="Open folder">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                                <Button ToolTipService.ToolTip="Unsubscribe">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="10" MaxWidth="240">
                                                <TextBlock Text="Stop following this? Videos already downloaded stay put." TextWrapping="Wrap" />
                                                <Button Content="Unsubscribe" Style="{StaticResource AccentButtonStyle}" Click="Remove_Click" Tag="{x:Bind}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
