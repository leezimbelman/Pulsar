<Page
    x:Class="Pulsar.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Pulsar.Models"
    xmlns:vm="using:Pulsar.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="28,8,28,20" ColumnSpacing="20" Background="Transparent"
          AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Tools" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,14" />

        <!-- Tool list -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind VM.Operations}" SelectionMode="Single"
                  SelectedIndex="{x:Bind VM.OperationIndex, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolInfo">
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel Spacing="14" Padding="0,0,12,0">
                <TextBlock Text="{x:Bind VM.Current.Description, Mode=OneWay}" Style="{StaticResource HintTextStyle}" FontSize="13" />

                <!-- Inputs -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="{x:Bind VM.InputSummary, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Command="{x:Bind VM.MoveUpCommand}" ToolTipService.ToolTip="Move up" Visibility="{x:Bind VM.ShowReorder, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                </Button>
                                <Button Command="{x:Bind VM.MoveDownCommand}" ToolTipService.ToolTip="Move down" Visibility="{x:Bind VM.ShowReorder, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                </Button>
                                <Button Content="Preview" Command="{x:Bind VM.PreviewCommand}" ToolTipService.ToolTip="Open the selected file in the player (handy for finding trim points)" />
                                <Button Content="Remove" Command="{x:Bind VM.RemoveSelectedCommand}" />
                                <Button Content="Clear" Command="{x:Bind VM.ClearInputsCommand}" />
                                <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind VM.AddFilesCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Add files" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                MinHeight="90" MaxHeight="240" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Visibility="{x:Bind VM.HasNoInputs, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="Drop video or audio files here" Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                                <ListView ItemsSource="{x:Bind VM.Inputs}" SelectionMode="Single"
                                          SelectedIndex="{x:Bind VM.SelectedInputIndex, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="m:MediaFile">
                                            <Grid Padding="0,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Info, Mode=OneWay}" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource HintTextStyle}" Visibility="{x:Bind VM.ShowBatchHint, Mode=OneWay}"
                                   Text="Every file in the list gets the same treatment, one after another." />
                        <TextBlock Style="{StaticResource HintTextStyle}" Visibility="{x:Bind VM.IsMerge, Mode=OneWay}"
                                   Text="Files are joined in the order shown. Select one and use the arrows to reorder." />
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <!-- Trim -->
                        <StackPanel Spacing="12" Visibility="{x:Bind VM.IsTrim, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Start" PlaceholderText="0:00" Text="{x:Bind VM.TrimStart, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Header="End" PlaceholderText="End of file" Text="{x:Bind VM.TrimEnd, Mode=TwoWay}" />
                            </Grid>
                            <ToggleSwitch Header="Cut mode"
                                          OffContent="Fast: no re-encode, cuts on the nearest keyframe"
                                          OnContent="Frame-accurate: re-encodes to H.264 MP4"
                                          IsOn="{x:Bind VM.AccurateTrim, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="Tip: in the player, press I and O to mark the start and end, then Send to Trim." />
                        </StackPanel>

                        <!-- Convert -->
                        <ComboBox Header="Convert to" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.ConvertPresets}"
                                  SelectedIndex="{x:Bind VM.ConvertPresetIndex, Mode=TwoWay}" Visibility="{x:Bind VM.IsConvert, Mode=OneWay}" />

                        <!-- Extract audio -->
                        <ComboBox Header="Audio format" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.AudioPresets}"
                                  SelectedIndex="{x:Bind VM.AudioPresetIndex, Mode=TwoWay}" Visibility="{x:Bind VM.IsExtract, Mode=OneWay}" />

                        <!-- Merge -->
                        <StackPanel Spacing="12" Visibility="{x:Bind VM.IsMerge, Mode=OneWay}">
                            <TextBox Header="Output file name" Text="{x:Bind VM.MergeName, Mode=TwoWay}" />
                            <ToggleSwitch Header="Method"
                                          OffContent="Fast: no re-encode (files must share the same format and settings)"
                                          OnContent="Re-encode: works with mixed formats and sizes, slower"
                                          IsOn="{x:Bind VM.MergeReencode, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Normalize -->
                        <StackPanel Spacing="8" Visibility="{x:Bind VM.IsNormalize, Mode=OneWay}">
                            <ComboBox Header="Loudness target" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.NormalizeTargets}"
                                      SelectedIndex="{x:Bind VM.NormalizeIndex, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Video is copied untouched; only the audio is re-encoded." />
                        </StackPanel>

                        <!-- Burn subtitles -->
                        <StackPanel Spacing="12" Visibility="{x:Bind VM.IsBurn, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Subtitle file" PlaceholderText="Leave blank to use a matching .srt next to each video"
                                         Text="{x:Bind VM.SubtitleFile, Mode=TwoWay}" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse…" Command="{x:Bind VM.BrowseSubtitleCommand}" />
                            </Grid>
                            <ComboBox Header="Text size" MinWidth="200" ItemsSource="{x:Bind VM.SubtitleSizes}"
                                      SelectedIndex="{x:Bind VM.SubtitleSizeIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Transform -->
                        <StackPanel Spacing="12" Visibility="{x:Bind VM.IsTransform, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Header="Rotate" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.Rotations}"
                                          SelectedIndex="{x:Bind VM.RotationIndex, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" Header="Crop to" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.Crops}"
                                          SelectedIndex="{x:Bind VM.CropIndex, Mode=TwoWay}" />
                                <ComboBox Grid.Column="2" Header="Resize" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.Sizes}"
                                          SelectedIndex="{x:Bind VM.SizeIndex, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <CheckBox Content="Flip horizontally (mirror)" IsChecked="{x:Bind VM.FlipHorizontal, Mode=TwoWay}" />
                                <CheckBox Content="Flip vertically" IsChecked="{x:Bind VM.FlipVertical, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="Crops are centered. Output is H.264 MP4." />
                        </StackPanel>

                        <!-- Transcribe -->
                        <StackPanel Spacing="12" Visibility="{x:Bind VM.IsTranscribe, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Header="Output" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.TranscriptFormats}"
                                          SelectedIndex="{x:Bind VM.TranscriptFormatIndex, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" Header="Spoken language" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VM.LanguageNames}"
                                          SelectedIndex="{x:Bind VM.LanguageIndex, Mode=TwoWay}" />
                            </Grid>
                            <CheckBox Content="Translate to English" IsChecked="{x:Bind VM.TranslateToEnglish, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind VM.EngineSummary, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Output folder" PlaceholderText="Same folder as each input file" Text="{x:Bind VM.OutputFolder, Mode=TwoWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse…" Command="{x:Bind VM.BrowseOutputCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{x:Bind VM.CancelCommand}" />
                            <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind VM.RunLabel, Mode=OneWay}" Command="{x:Bind VM.RunCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind VM.Status, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind VM.HasOutput, Mode=OneWay}">
                                <Button Content="Play" Command="{x:Bind VM.PlayOutputCommand}" />
                                <Button Content="Show in folder" Command="{x:Bind VM.OpenOutputCommand}" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{x:Bind VM.Percent, Mode=OneWay}" IsIndeterminate="{x:Bind VM.ShowIndeterminate, Mode=OneWay}" />
                        <Expander Header="Log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBox Text="{x:Bind VM.Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="140" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
